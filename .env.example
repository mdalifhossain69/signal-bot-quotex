# Signal Bot - Quotex configuration
# Copy this file to .env and fill in your values.

# Execution mode: mock (simulated trades) or real (live Quotex)
SIGNAL_BOT_MODE=mock

# Quotex credentials (required for real mode)
QUOTEX_EMAIL=your-email@example.com
QUOTEX_PASSWORD=your-password
# Alternatively authenticate with an SSID:
# QUOTEX_SSID=your-session-id
QUOTEX_DEMO=true
QUOTEX_WSS_URL=wss://wsb2.qxbroker.com/socket.io/?EIO=4&transport=websocket

# Defaults
DEFAULT_SYMBOL=EURUSD
DEFAULT_AMOUNT=1.0
DEFAULT_DURATION=5
DEFAULT_DURATION_UNIT=m

# Risk management
MAX_DAILY_LOSS=20.0
MAX_DAILY_PROFIT=100.0
MAX_CONCURRENT_TRADES=1
MIN_CONFIDENCE=0.0

# Logging
LOG_LEVEL=INFO
# LOG_FILE=signal_bot.log
